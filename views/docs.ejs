<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= config.siteName %></title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #050b08;
            background-image: 
                radial-gradient(at 10% 10%, rgba(16, 185, 129, 0.12) 0px, transparent 40%),
                radial-gradient(at 90% 90%, rgba(5, 150, 105, 0.08) 0px, transparent 40%);
            background-attachment: fixed;
        }

        .liquid-glass {
            background: rgba(6, 23, 16, 0.55);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(52, 211, 153, 0.2);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.05);
        }

        .liquid-glass-glow {
            background: rgba(6, 23, 16, 0.7);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(16, 185, 129, 0.35);
            box-shadow: 0 0 35px rgba(16, 185, 129, 0.12);
        }

        #sidebar { transition: transform 0.3s ease-in-out; }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #050b08; }
        ::-webkit-scrollbar-thumb { background: #064e3b; border-radius: 3px; }
    </style>
</head>
<body class="font-sans text-emerald-100 min-h-screen flex flex-col justify-between p-4 sm:p-8">

    <!-- OVERLAY SIDEBAR -->
    <div id="sidebar-backdrop" onclick="toggleSidebar()" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-40 hidden transition-opacity"></div>

    <!-- SIDEBAR NAVIGASI -->
    <aside id="sidebar" class="fixed top-0 left-0 h-full w-72 bg-stone-950/95 border-r border-emerald-500/20 z-50 transform -translate-x-full p-6 flex flex-col justify-between shadow-2xl liquid-glass">
        <div>
            <div class="flex items-center justify-between pb-6 border-b border-emerald-900/50">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-600 flex items-center justify-center text-black font-extrabold text-sm shadow-md">
                        <i class="fa-solid fa-bolt"></i>
                    </div>
                    <span class="font-extrabold text-white text-sm tracking-wide"><%= config.siteName %></span>
                </div>
                <button onclick="toggleSidebar()" class="text-emerald-400 hover:text-white p-2">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <nav class="mt-6 space-y-2">
                <button onclick="switchTab('docs')" id="nav-docs" class="w-full text-left px-4 py-3 rounded-xl font-bold text-xs sm:text-sm flex items-center gap-3 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                    <i class="fa-solid fa-code text-lg"></i> Dokumentasi API
                </button>
                <button onclick="switchTab('settings')" id="nav-settings" class="w-full text-left px-4 py-3 rounded-xl font-bold text-xs sm:text-sm flex items-center gap-3 text-emerald-400/70 hover:bg-emerald-950/40 hover:text-white">
                    <i class="fa-solid fa-sliders text-lg"></i> Pengaturan & Limit Key
                </button>
                <button onclick="switchTab('logs')" id="nav-logs" class="w-full text-left px-4 py-3 rounded-xl font-bold text-xs sm:text-sm flex items-center gap-3 text-emerald-400/70 hover:bg-emerald-950/40 hover:text-white">
                    <i class="fa-solid fa-bug text-lg text-rose-400"></i> Error Logs Viewer
                </button>
            </nav>
        </div>

        <div class="text-xs text-emerald-500/60 text-center border-t border-emerald-900/50 pt-4 font-mono">
            <%= config.siteName %> &bull; Neon Green Glass
        </div>
    </aside>

    <!-- CONTAINER UTAMA -->
    <div class="max-w-5xl mx-auto w-full space-y-8">
        
        <!-- TOPBAR HEADER -->
        <header class="flex items-center justify-between liquid-glass p-5 rounded-3xl">
            <div class="flex items-center gap-4">
                <button onclick="toggleSidebar()" class="p-3 bg-emerald-950/50 hover:bg-emerald-900/50 border border-emerald-500/30 text-emerald-400 rounded-2xl transition flex items-center gap-2">
                    <i class="fa-solid fa-bars text-lg"></i>
                    <span class="text-xs font-bold text-emerald-200 hidden sm:inline">Menu Navigasi</span>
                </button>

                <div>
                    <h1 class="font-extrabold text-base sm:text-lg text-white tracking-wide"><%= config.siteName %></h1>
                    <p class="text-xs text-emerald-400/70 hidden sm:block">Platform Rest API Suite</p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_10px_#34d399]"></span>
                <span class="text-xs font-mono text-emerald-300 font-semibold">Online</span>
            </div>
        </header>

        <!-- TAB 1: DOKUMENTASI API -->
        <div id="tab-docs" class="space-y-6">
            <div class="liquid-glass p-6 sm:p-8 rounded-3xl space-y-6">
                <div>
                    <h2 class="text-xl font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-cubes text-emerald-400"></i> Daftar Endpoint & Contoh Integrasi
                    </h2>
                    <p class="text-emerald-300/70 text-xs sm:text-sm mt-1">Klik pada nama endpoint untuk melihat parameter, uji coba langsung, dan contoh salinan kode.</p>
                </div>

                <!-- ENDPOINT 1: AI PROMPT -->
                <div class="rounded-2xl bg-emerald-950/30 border border-emerald-900/50 overflow-hidden">
                    <button onclick="toggleAccordion('ai')" class="w-full p-4 sm:p-5 flex items-center justify-between hover:bg-emerald-900/20 transition text-left">
                        <div class="flex items-center gap-3 font-mono text-xs sm:text-sm">
                            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold">GET</span>
                            <span class="text-white font-bold">/api/ai</span>
                            <span class="text-emerald-400/60 text-xs hidden sm:inline">- Groq AI Prompt</span>
                        </div>
                        <i id="accordion-icon-ai" class="fa-solid fa-chevron-right text-emerald-400 text-sm transition-transform duration-300"></i>
                    </button>

                    <div id="accordion-content-ai" class="hidden p-5 border-t border-emerald-900/40 space-y-6 bg-emerald-950/20">
                        <table class="w-full text-left text-xs font-mono">
                            <thead class="bg-emerald-950 text-emerald-400 border-b border-emerald-900"><tr><th class="p-2">Parameter</th><th class="p-2">Wajib</th><th class="p-2">Keterangan</th></tr></thead>
                            <tbody class="divide-y divide-emerald-900/30 text-emerald-200">
                                <tr><td class="p-2 text-emerald-400 font-bold">apikey</td><td class="p-2">Ya</td><td class="p-2">Kunci API</td></tr>
                                <tr><td class="p-2 text-emerald-400 font-bold">prompt</td><td class="p-2">Ya</td><td class="p-2">Pertanyaan AI</td></tr>
                            </tbody>
                        </table>
                        <div class="space-y-3">
                            <div class="flex gap-2">
                                <input type="text" id="test-prompt-ai" placeholder="Tanya sesuatu..." class="w-full bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-xs text-white font-mono">
                                <button onclick="testAiApi()" class="px-5 py-3 bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 rounded-xl text-xs font-bold">Kirim</button>
                            </div>
                            <div id="test-result-box-ai" class="hidden p-3 bg-emerald-950/80 rounded-xl font-mono text-xs text-emerald-300"><pre id="test-result-json-ai"></pre></div>
                        </div>
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs text-emerald-400"><span>cURL / JS Example</span><button onclick="copyCode('code-ai', this)" class="px-2 py-1 bg-emerald-900 text-white rounded text-[10px]">Copy</button></div>
                            <div class="p-3 bg-emerald-950 rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto"><pre id="code-ai">curl "https://apikeyzenuth.vercel.app/api/ai?apikey=YOUR_KEY&prompt=halo"</pre></div>
                        </div>
                    </div>
                </div>

                <!-- ENDPOINT 2: TRANSLATE -->
                <div class="rounded-2xl bg-emerald-950/30 border border-emerald-900/50 overflow-hidden">
                    <button onclick="toggleAccordion('translate')" class="w-full p-4 sm:p-5 flex items-center justify-between hover:bg-emerald-900/20 transition text-left">
                        <div class="flex items-center gap-3 font-mono text-xs sm:text-sm">
                            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold">GET</span>
                            <span class="text-white font-bold">/api/translate</span>
                            <span class="text-emerald-400/60 text-xs hidden sm:inline">- Fast Translator</span>
                        </div>
                        <i id="accordion-icon-translate" class="fa-solid fa-chevron-right text-emerald-400 text-sm transition-transform duration-300"></i>
                    </button>
                    <div id="accordion-content-translate" class="hidden p-5 border-t border-emerald-900/40 space-y-6 bg-emerald-950/20">
                        <div class="space-y-3">
                            <div class="flex gap-2">
                                <input type="text" id="test-text-trans" placeholder="Teks..." class="w-full bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-xs text-white font-mono">
                                <select id="test-to-trans" class="bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-xs text-emerald-300 font-mono"><option value="en">en</option><option value="id">id</option></select>
                                <button onclick="testTranslateApi()" class="px-5 py-3 bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 rounded-xl text-xs font-bold">Terjemahkan</button>
                            </div>
                            <div id="test-result-box-trans" class="hidden p-3 bg-emerald-950/80 rounded-xl font-mono text-xs text-emerald-300"><pre id="test-result-json-trans"></pre></div>
                        </div>
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs text-emerald-400"><span>cURL Example</span><button onclick="copyCode('code-trans', this)" class="px-2 py-1 bg-emerald-900 text-white rounded text-[10px]">Copy</button></div>
                            <div class="p-3 bg-emerald-950 rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto"><pre id="code-trans">curl "https://apikeyzenuth.vercel.app/api/translate?apikey=YOUR_KEY&text=halo&to=en"</pre></div>
                        </div>
                    </div>
                </div>

                <!-- ENDPOINT 3: BYPASS -->
                <div class="rounded-2xl bg-emerald-950/30 border border-emerald-900/50 overflow-hidden">
                    <button onclick="toggleAccordion('bypass')" class="w-full p-4 sm:p-5 flex items-center justify-between hover:bg-emerald-900/20 transition text-left">
                        <div class="flex items-center gap-3 font-mono text-xs sm:text-sm">
                            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold">GET</span>
                            <span class="text-white font-bold">/api/bypass</span>
                            <span class="text-emerald-400/60 text-xs hidden sm:inline">- Bypass Engine</span>
                        </div>
                        <i id="accordion-icon-bypass" class="fa-solid fa-chevron-right text-emerald-400 text-sm transition-transform duration-300"></i>
                    </button>
                    <div id="accordion-content-bypass" class="hidden p-5 border-t border-emerald-900/40 space-y-6 bg-emerald-950/20">
                        <div class="space-y-3">
                            <div class="flex gap-2">
                                <input type="text" id="test-url-bypass" placeholder="https://sfl.gl/xxx" class="w-full bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-xs text-white font-mono">
                                <button onclick="testBypassApi()" class="px-5 py-3 bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 rounded-xl text-xs font-bold">Bypass</button>
                            </div>
                            <div id="test-result-box-bypass" class="hidden p-3 bg-emerald-950/80 rounded-xl font-mono text-xs text-emerald-300"><pre id="test-result-json-bypass"></pre></div>
                        </div>
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs text-emerald-400"><span>cURL Example</span><button onclick="copyCode('code-bypass', this)" class="px-2 py-1 bg-emerald-900 text-white rounded text-[10px]">Copy</button></div>
                            <div class="p-3 bg-emerald-950 rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto"><pre id="code-bypass">curl "https://apikeyzenuth.vercel.app/api/bypass?apikey=YOUR_KEY&url=https://sfl.gl/xxx"</pre></div>
                        </div>
                    </div>
                </div>

                <!-- ENDPOINT 4: CALC -->
                <div class="rounded-2xl bg-emerald-950/30 border border-emerald-900/50 overflow-hidden">
                    <button onclick="toggleAccordion('calc')" class="w-full p-4 sm:p-5 flex items-center justify-between hover:bg-emerald-900/20 transition text-left">
                        <div class="flex items-center gap-3 font-mono text-xs sm:text-sm">
                            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold">GET</span>
                            <span class="text-white font-bold">/api/calc</span>
                            <span class="text-emerald-400/60 text-xs hidden sm:inline">- Kalkulator Engine</span>
                        </div>
                        <i id="accordion-icon-calc" class="fa-solid fa-chevron-right text-emerald-400 text-sm transition-transform duration-300"></i>
                    </button>
                    <div id="accordion-content-calc" class="hidden p-5 border-t border-emerald-900/40 space-y-6 bg-emerald-950/20">
                        <div class="space-y-3">
                            <div class="flex gap-2">
                                <input type="number" id="test-angka1" placeholder="Angka 1" class="w-full bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-xs text-white font-mono">
                                <select id="test-op" class="bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-xs text-emerald-300 font-mono"><option value="+">+</option><option value="-">-</option><option value="x">x</option><option value=":">:</option></select>
                                <input type="number" id="test-angka2" placeholder="Angka 2" class="w-full bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-xs text-white font-mono">
                                <button onclick="testCalcApi()" class="px-5 py-3 bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 rounded-xl text-xs font-bold">Hitung</button>
                            </div>
                            <div id="test-result-box-calc" class="hidden p-3 bg-emerald-950/80 rounded-xl font-mono text-xs text-emerald-300"><pre id="test-result-json-calc"></pre></div>
                        </div>
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs text-emerald-400"><span>cURL Example</span><button onclick="copyCode('code-calc', this)" class="px-2 py-1 bg-emerald-900 text-white rounded text-[10px]">Copy</button></div>
                            <div class="p-3 bg-emerald-950 rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto"><pre id="code-calc">curl "https://apikeyzenuth.vercel.app/api/calc?apikey=YOUR_KEY&angka1=10&op=x&angka2=5"</pre></div>
                        </div>
                    </div>
                </div>

                <!-- ENDPOINT 5: PARAPHRASE -->
                <div class="rounded-2xl bg-emerald-950/30 border border-emerald-900/50 overflow-hidden">
                    <button onclick="toggleAccordion('paraphrase')" class="w-full p-4 sm:p-5 flex items-center justify-between hover:bg-emerald-900/20 transition text-left">
                        <div class="flex items-center gap-3 font-mono text-xs sm:text-sm">
                            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold">GET</span>
                            <span class="text-white font-bold">/api/paraphrase</span>
                            <span class="text-emerald-400/60 text-xs hidden sm:inline">- Groq Paraphrase</span>
                        </div>
                        <i id="accordion-icon-paraphrase" class="fa-solid fa-chevron-right text-emerald-400 text-sm transition-transform duration-300"></i>
                    </button>
                    <div id="accordion-content-paraphrase" class="hidden p-5 border-t border-emerald-900/40 space-y-6 bg-emerald-950/20">
                        <div class="space-y-3">
                            <div class="flex gap-2">
                                <input type="text" id="test-text-para" placeholder="Teks..." class="w-full bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-xs text-white font-mono">
                                <button onclick="testParaApi()" class="px-5 py-3 bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 rounded-xl text-xs font-bold">Parafrase</button>
                            </div>
                            <div id="test-result-box-para" class="hidden p-3 bg-emerald-950/80 rounded-xl font-mono text-xs text-emerald-300"><pre id="test-result-json-para"></pre></div>
                        </div>
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs text-emerald-400"><span>cURL Example</span><button onclick="copyCode('code-para', this)" class="px-2 py-1 bg-emerald-900 text-white rounded text-[10px]">Copy</button></div>
                            <div class="p-3 bg-emerald-950 rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto"><pre id="code-para">curl "https://apikeyzenuth.vercel.app/api/paraphrase?apikey=YOUR_KEY&text=halo"</pre></div>
                        </div>
                    </div>
                </div>

                <!-- ENDPOINT 6: STORY -->
                <div class="rounded-2xl bg-emerald-950/30 border border-emerald-900/50 overflow-hidden">
                    <button onclick="toggleAccordion('story')" class="w-full p-4 sm:p-5 flex items-center justify-between hover:bg-emerald-900/20 transition text-left">
                        <div class="flex items-center gap-3 font-mono text-xs sm:text-sm">
                            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold">GET</span>
                            <span class="text-white font-bold">/api/story</span>
                            <span class="text-emerald-400/60 text-xs hidden sm:inline">- Groq Story</span>
                        </div>
                        <i id="accordion-icon-story" class="fa-solid fa-chevron-right text-emerald-400 text-sm transition-transform duration-300"></i>
                    </button>
                    <div id="accordion-content-story" class="hidden p-5 border-t border-emerald-900/40 space-y-6 bg-emerald-950/20">
                        <div class="space-y-3">
                            <div class="flex gap-2">
                                <input type="text" id="test-topic-story" placeholder="Tema cerita..." class="w-full bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-xs text-white font-mono">
                                <button onclick="testStoryApi()" class="px-5 py-3 bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 rounded-xl text-xs font-bold">Buat</button>
                            </div>
                            <div id="test-result-box-story" class="hidden p-3 bg-emerald-950/80 rounded-xl font-mono text-xs text-emerald-300"><pre id="test-result-json-story"></pre></div>
                        </div>
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs text-emerald-400"><span>cURL Example</span><button onclick="copyCode('code-story', this)" class="px-2 py-1 bg-emerald-900 text-white rounded text-[10px]">Copy</button></div>
                            <div class="p-3 bg-emerald-950 rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto"><pre id="code-story">curl "https://apikeyzenuth.vercel.app/api/story?apikey=YOUR_KEY&topic=petualangan"</pre></div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- TAB 2: SETTINGS -->
        <div id="tab-settings" class="hidden space-y-6">
            <div class="liquid-glass-glow p-6 rounded-3xl space-y-4">
                <div class="flex justify-between items-center">
                    <h2 class="text-lg font-bold text-white">Status API Key</h2>
                    <button onclick="generateApiKey()" class="px-4 py-2 bg-emerald-500 text-black font-bold rounded-xl text-xs">Generate Key</button>
                </div>
                <div class="p-4 bg-emerald-950/60 rounded-xl border border-emerald-500/30 font-mono text-xs space-y-2">
                    <div>Key: <span id="display-key" class="text-emerald-300">SAW-XXXXXX</span></div>
                    <div>Terpakai: <span id="stat-used">0</span> | Sisa Limit: <span id="stat-remaining">100</span></div>
                </div>
            </div>
        </div>

        <!-- TAB 3: LOGS -->
        <div id="tab-logs" class="hidden space-y-6">
            <div class="liquid-glass p-6 rounded-3xl space-y-4">
                <h2 class="text-lg font-bold text-white">Error Logs</h2>
                <div id="logs-container" class="font-mono text-xs text-emerald-400">Memuat log...</div>
            </div>
        </div>

    </div>

    <footer class="text-center text-emerald-500/60 text-xs mt-12 py-4"><%= config.siteName %> &bull; Neon Green Glass</footer>

    <script>
        let currentApiKey = localStorage.getItem('saw_api_key') || '';
        document.addEventListener('DOMContentLoaded', () => { if (currentApiKey) checkKeyStatus(currentApiKey); });

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('-translate-x-full');
            document.getElementById('sidebar-backdrop').classList.toggle('hidden');
        }

        function toggleAccordion(name) {
            document.getElementById(`accordion-content-${name}`).classList.toggle('hidden');
            document.getElementById(`accordion-icon-${name}`).classList.toggle('rotate-90');
        }

        function switchTab(tabName) {
            ['docs', 'settings', 'logs'].forEach(tab => {
                document.getElementById(`tab-${tab}`).classList.add('hidden');
                document.getElementById(`nav-${tab}`).className = "w-full text-left px-4 py-3 rounded-xl font-bold text-xs sm:text-sm flex items-center gap-3 text-emerald-400/70 hover:bg-emerald-950/40 hover:text-white";
            });
            document.getElementById(`tab-${tabName}`).classList.remove('hidden');
            document.getElementById(`nav-${tabName}`).className = "w-full text-left px-4 py-3 rounded-xl font-bold text-xs sm:text-sm flex items-center gap-3 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30";
            if (tabName === 'logs') fetchErrorLogs();
            toggleSidebar();
        }

        function copyCode(id, btn) {
            navigator.clipboard.writeText(document.getElementById(id).innerText).then(() => {
                let orig = btn.innerText;
                btn.innerText = 'Copied!';
                setTimeout(() => btn.innerText = orig, 2000);
            });
        }

        async function generateApiKey() {
            const res = await fetch('/api/generate-key', { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                currentApiKey = data.key;
                localStorage.setItem('saw_api_key', data.key);
                checkKeyStatus(data.key);
                alert('✓ API Key berhasil dibuat!');
            }
        }

        async function checkKeyStatus(key) {
            const res = await fetch(`/api/check-key?apikey=${key}`);
            const data = await res.json();
            if (data.success) {
                document.getElementById('display-key').innerText = data.key;
                document.getElementById('stat-used').innerText = data.used;
                document.getElementById('stat-remaining').innerText = data.remaining;
            }
        }

        async function testAiApi() {
            if (!currentApiKey) return alert('Buat API Key dulu!');
            const prompt = document.getElementById('test-prompt-ai').value;
            const res = await fetch(`/api/ai?apikey=${currentApiKey}&prompt=${encodeURIComponent(prompt)}`);
            const data = await res.json();
            document.getElementById('test-result-box-ai').classList.remove('hidden');
            document.getElementById('test-result-json-ai').innerText = JSON.stringify(data, null, 2);
            checkKeyStatus(currentApiKey);
        }

