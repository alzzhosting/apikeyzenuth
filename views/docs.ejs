<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= config.siteName %></title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #050b08;
            background-image: 
                radial-gradient(at 10% 10%, rgba(16, 185, 129, 0.12) 0px, transparent 40%),
                radial-gradient(at 90% 90%, rgba(5, 150, 105, 0.08) 0px, transparent 40%);
            background-attachment: fixed;
        }

        .liquid-glass {
            background: rgba(6, 23, 16, 0.55);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(52, 211, 153, 0.2);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.05);
        }

        .liquid-glass-glow {
            background: rgba(6, 23, 16, 0.7);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(16, 185, 129, 0.35);
            box-shadow: 0 0 35px rgba(16, 185, 129, 0.12);
        }

        #sidebar { transition: transform 0.3s ease-in-out; }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #050b08; }
        ::-webkit-scrollbar-thumb { background: #064e3b; border-radius: 3px; }
    </style>
</head>
<body class="font-sans text-emerald-100 min-h-screen flex flex-col justify-between p-4 sm:p-8">

    <!-- OVERLAY SIDEBAR -->
    <div id="sidebar-backdrop" onclick="toggleSidebar()" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-40 hidden transition-opacity"></div>

    <!-- SIDEBAR NAVIGASI -->
    <aside id="sidebar" class="fixed top-0 left-0 h-full w-72 bg-stone-950/95 border-r border-emerald-500/20 z-50 transform -translate-x-full p-6 flex flex-col justify-between shadow-2xl liquid-glass">
        <div>
            <div class="flex items-center justify-between pb-6 border-b border-emerald-900/50">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-600 flex items-center justify-center text-black font-extrabold text-sm shadow-md">
                        <i class="fa-solid fa-bolt"></i>
                    </div>
                    <span class="font-extrabold text-white text-sm tracking-wide"><%= config.siteName %></span>
                </div>
                <button onclick="toggleSidebar()" class="text-emerald-400 hover:text-white p-2">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <nav class="mt-6 space-y-2">
                <button onclick="switchTab('docs')" id="nav-docs" class="w-full text-left px-4 py-3 rounded-xl font-bold text-xs sm:text-sm flex items-center gap-3 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                    <i class="fa-solid fa-code text-lg"></i> Dokumentasi API
                </button>
                <button onclick="switchTab('settings')" id="nav-settings" class="w-full text-left px-4 py-3 rounded-xl font-bold text-xs sm:text-sm flex items-center gap-3 text-emerald-400/70 hover:bg-emerald-950/40 hover:text-white">
                    <i class="fa-solid fa-sliders text-lg"></i> Pengaturan & Limit Key
                </button>
                <button onclick="switchTab('logs')" id="nav-logs" class="w-full text-left px-4 py-3 rounded-xl font-bold text-xs sm:text-sm flex items-center gap-3 text-emerald-400/70 hover:bg-emerald-950/40 hover:text-white">
                    <i class="fa-solid fa-bug text-lg text-rose-400"></i> Error Logs Viewer
                </button>
            </nav>
        </div>

        <div class="text-xs text-emerald-500/60 text-center border-t border-emerald-900/50 pt-4 font-mono">
            <%= config.siteName %> &bull; Neon Green Glass
        </div>
    </aside>

    <!-- CONTAINER UTAMA -->
    <div class="max-w-5xl mx-auto w-full space-y-8">
        
        <!-- TOPBAR HEADER -->
        <header class="flex items-center justify-between liquid-glass p-5 rounded-3xl">
            <div class="flex items-center gap-4">
                <button onclick="toggleSidebar()" class="p-3 bg-emerald-950/50 hover:bg-emerald-900/50 border border-emerald-500/30 text-emerald-400 rounded-2xl transition flex items-center gap-2">
                    <i class="fa-solid fa-bars text-lg"></i>
                    <span class="text-xs font-bold text-emerald-200 hidden sm:inline">Menu Navigasi</span>
                </button>

                <div>
                    <h1 class="font-extrabold text-base sm:text-lg text-white tracking-wide"><%= config.siteName %></h1>
                    <p class="text-xs text-emerald-400/70 hidden sm:block">Platform Rest API Suite</p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_10px_#34d399]"></span>
                <span class="text-xs font-mono text-emerald-300 font-semibold">Online</span>
            </div>
        </header>

        <!-- TAB 1: DOKUMENTASI API -->
        <div id="tab-docs" class="space-y-6">
            <div class="liquid-glass p-6 sm:p-8 rounded-3xl space-y-6">
                <div>
                    <h2 class="text-xl font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-cubes text-emerald-400"></i> Daftar Endpoint & Contoh Integrasi
                    </h2>
                    <p class="text-emerald-300/70 text-xs sm:text-sm mt-1">Gunakan endpoint Character Story (CS) untuk membuat cerita roleplay SA-MP secara instan.</p>
                </div>

                <!-- ENDPOINT BARU: CHARACTER STORY (CS) -->
                <div class="rounded-2xl bg-emerald-950/30 border border-emerald-900/50 overflow-hidden">
                    <button onclick="toggleAccordion('cs')" class="w-full p-4 sm:p-5 flex items-center justify-between hover:bg-emerald-900/20 transition text-left">
                        <div class="flex items-center gap-3 font-mono text-xs sm:text-sm">
                            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold">GET</span>
                            <span class="text-white font-bold">/api/character-story</span>
                            <span class="text-emerald-400/60 text-xs hidden sm:inline">- SA-MP Character Story Creator</span>
                        </div>
                        <i id="accordion-icon-cs" class="fa-solid fa-chevron-right text-emerald-400 text-sm transition-transform duration-300"></i>
                    </button>

                    <div id="accordion-content-cs" class="hidden p-5 border-t border-emerald-900/40 space-y-6 bg-emerald-950/20">
                        <div class="space-y-3 font-mono text-xs">
                            <span class="text-emerald-400 font-bold uppercase tracking-wider block">Form Detail Karakter SA-MP</span>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-stone-400 mb-1">Nama Karakter (IC) *</label>
                                    <input type="text" id="cs-nama" placeholder="Contoh: Jack_Ainsley" class="w-full bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-white">
                                </div>
                                <div>
                                    <label class="block text-stone-400 mb-1">Tanggal / Tahun Lahir *</label>
                                    <input type="text" id="cs-tgl" placeholder="Contoh: 12 April 1998" class="w-full bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-white">
                                </div>
                                <div>
                                    <label class="block text-stone-400 mb-1">Asal / Kewarganegaraan *</label>
                                    <input type="text" id="cs-asal" placeholder="Contoh: United States of America" class="w-full bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-white">
                                </div>
                                <div>
                                    <label class="block text-stone-400 mb-1">Latar Belakang Kehidupan</label>
                                    <select id="cs-latar" class="w-full bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-emerald-300">
                                        <option value="Perantau / Pencari Kerja">Perantau / Pencari Kerja</option>
                                        <option value="Mantan Anggota Geng / Street Life">Mantan Anggota Geng / Street Life</option>
                                        <option value="Keluarga Kaya / Bangsawan">Keluarga Kaya / Bangsawan</option>
                                        <option value="Anak Jalanan / Yatim Piatu">Anak Jalanan / Yatim Piatu</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-stone-400 mb-1">Vibe Kepribadian</label>
                                    <select id="cs-vibe" class="w-full bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-emerald-300">
                                        <option value="Tenang, Misterius, dan Perhitungan">Tenang, Misterius, dan Perhitungan</option>
                                        <option value="Keras Kepala, Suka Onar, dan Berani">Keras Kepala, Suka Onar, dan Berani</option>
                                        <option value="Ramah, Pekerja Keras, dan Loyal">Ramah, Pekerja Keras, dan Loyal</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-stone-400 mb-1">Jumlah Paragraf</label>
                                    <select id="cs-paragraf" class="w-full bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-emerald-300">
                                        <option value="3 Paragraf (~300 Kata)">3 Paragraf (~300 Kata)</option>
                                        <option value="4 Paragraf (~450 Kata)" selected>4 Paragraf (~450 Kata)</option>
                                        <option value="5 Paragraf (~600 Kata)">5 Paragraf (~600 Kata)</option>
                                    </select>
                                </div>
                            </div>
                            <div>
                                <label class="block text-stone-400 mb-1">Catatan Tambahan (Opsi)</label>
                                <textarea id="cs-catatan" placeholder="Contoh: Datang ke Los Santos mencari kakaknya yang hilang..." rows="2" class="w-full bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-white"></textarea>
                            </div>
                            <button onclick="testCsApi()" class="w-full py-3 bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/40 rounded-xl font-bold transition"><i class="fa-solid fa-scroll"></i> Buat Karakter (Submit CS)</button>
                            <div id="test-result-box-cs" class="hidden p-3 bg-emerald-950/80 rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto"><pre id="test-result-json-cs"></pre></div>
                        </div>

                        <div class="space-y-2">
                            <div class="flex justify-between text-xs text-emerald-400"><span>cURL Example</span><button onclick="copyCode('code-cs-curl', this)" class="px-2 py-1 bg-emerald-900 text-white rounded text-[10px]">Copy</button></div>
                            <div class="p-3 bg-emerald-950 rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto"><pre id="code-cs-curl">curl "https://apikeyzenuth.vercel.app/api/character-story?apikey=YOUR_KEY&nama=Jack_Ainsley&tanggalLahir=12%20April%201998&asal=USA&paragraf=4%20Paragraf"</pre></div>
                        </div>

                        <div class="space-y-2">
                            <div class="flex justify-between text-xs text-emerald-400"><span>JavaScript (Fetch) Example</span><button onclick="copyCode('code-cs-js', this)" class="px-2 py-1 bg-emerald-900 text-white rounded text-[10px]">Copy</button></div>
                            <div class="p-3 bg-emerald-950 rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto"><pre id="code-cs-js">const res = await fetch('https://apikeyzenuth.vercel.app/api/character-story?apikey=YOUR_KEY&nama=Jack_Ainsley&tanggalLahir=12%20April%201998&asal=USA');
const data = await res.json();
console.log(data.result);</pre></div>
                        </div>
                    </div>
                </div>

                <!-- ENDPOINT LAINNYA (AI, TRANSLATE, BYPASS, CALC, PARAPHRASE, STORY) -->
                <!-- AI PROMPT -->
                <div class="rounded-2xl bg-emerald-950/30 border border-emerald-900/50 overflow-hidden">
                    <button onclick="toggleAccordion('ai')" class="w-full p-4 sm:p-5 flex items-center justify-between hover:bg-emerald-900/20 transition text-left">
                        <div class="flex items-center gap-3 font-mono text-xs sm:text-sm">
                            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold">GET</span>
                            <span class="text-white font-bold">/api/ai</span>
                            <span class="text-emerald-400/60 text-xs hidden sm:inline">- Groq AI Prompt</span>
                        </div>
                        <i id="accordion-icon-ai" class="fa-solid fa-chevron-right text-emerald-400 text-sm transition-transform duration-300"></i>
                    </button>
                    <div id="accordion-content-ai" class="hidden p-5 border-t border-emerald-900/40 space-y-6 bg-emerald-950/20">
                        <div class="flex gap-2">
                            <input type="text" id="test-prompt-ai" placeholder="Tanya sesuatu..." class="w-full bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-xs text-white font-mono">
                            <button onclick="testAiApi()" class="px-5 py-3 bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 rounded-xl text-xs font-bold">Kirim</button>
                        </div>
                        <div id="test-result-box-ai" class="hidden p-3 bg-emerald-950/80 rounded-xl font-mono text-xs text-emerald-300"><pre id="test-result-json-ai"></pre></div>
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs text-emerald-400"><span>cURL Example</span><button onclick="copyCode('code-ai-curl', this)" class="px-2 py-1 bg-emerald-900 text-white rounded text-[10px]">Copy</button></div>
                            <div class="p-3 bg-emerald-950 rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto"><pre id="code-ai-curl">curl "https://apikeyzenuth.vercel.app/api/ai?apikey=YOUR_KEY&prompt=halo"</pre></div>
                        </div>
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs text-emerald-400"><span>JavaScript Example</span><button onclick="copyCode('code-ai-js', this)" class="px-2 py-1 bg-emerald-900 text-white rounded text-[10px]">Copy</button></div>
                            <div class="p-3 bg-emerald-950 rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto"><pre id="code-ai-js">const res = await fetch('https://apikeyzenuth.vercel.app/api/ai?apikey=YOUR_KEY&prompt=halo');
const data = await res.json();
console.log(data.result);</pre></div>
                        </div>
                    </div>
                </div>

                <!-- TRANSLATE -->
                <div class="rounded-2xl bg-emerald-950/30 border border-emerald-900/50 overflow-hidden">
                    <button onclick="toggleAccordion('translate')" class="w-full p-4 sm:p-5 flex items-center justify-between hover:bg-emerald-900/20 transition text-left">
                        <div class="flex items-center gap-3 font-mono text-xs sm:text-sm">
                            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold">GET</span>
                            <span class="text-white font-bold">/api/translate</span>
                            <span class="text-emerald-400/60 text-xs hidden sm:inline">- Fast Translator</span>
                        </div>
                        <i id="accordion-icon-translate" class="fa-solid fa-chevron-right text-emerald-400 text-sm transition-transform duration-300"></i>
                    </button>
                    <div id="accordion-content-translate" class="hidden p-5 border-t border-emerald-900/40 space-y-6 bg-emerald-950/20">
                        <div class="flex gap-2">
                            <input type="text" id="test-text-trans" placeholder="Teks..." class="w-full bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-xs text-white font-mono">
                            <button onclick="testTranslateApi()" class="px-5 py-3 bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 rounded-xl text-xs font-bold">Translate</button>
                        </div>
                        <div id="test-result-box-trans" class="hidden p-3 bg-emerald-950/80 rounded-xl font-mono text-xs text-emerald-300"><pre id="test-result-json-trans"></pre></div>
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs text-emerald-400"><span>cURL Example</span><button onclick="copyCode('code-trans-curl', this)" class="px-2 py-1 bg-emerald-900 text-white rounded text-[10px]">Copy</button></div>
                            <div class="p-3 bg-emerald-950 rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto"><pre id="code-trans-curl">curl "https://apikeyzenuth.vercel.app/api/translate?apikey=YOUR_KEY&text=halo&to=en"</pre></div>
                        </div>
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs text-emerald-400"><span>JavaScript Example</span><button onclick="copyCode('code-trans-js', this)" class="px-2 py-1 bg-emerald-900 text-white rounded text-[10px]">Copy</button></div>
                            <div class="p-3 bg-emerald-950 rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto"><pre id="code-trans-js">const res = await fetch('https://apikeyzenuth.vercel.app/api/translate?apikey=YOUR_KEY&text=halo&to=en');
const data = await res.json();
console.log(data.result);</pre></div>
                        </div>
                    </div>
                </div>

                <!-- BYPASS -->
                <div class="rounded-2xl bg-emerald-950/30 border border-emerald-900/50 overflow-hidden">
                    <button onclick="toggleAccordion('bypass')" class="w-full p-4 sm:p-5 flex items-center justify-between hover:bg-emerald-900/20 transition text-left">
                        <div class="flex items-center gap-3 font-mono text-xs sm:text-sm">
                            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold">GET</span>
                            <span class="text-white font-bold">/api/bypass</span>
                            <span class="text-emerald-400/60 text-xs hidden sm:inline">- Bypass Engine</span>
                        </div>
                        <i id="accordion-icon-bypass" class="fa-solid fa-chevron-right text-emerald-400 text-sm transition-transform duration-300"></i>
                    </button>
                    <div id="accordion-content-bypass" class="hidden p-5 border-t border-emerald-900/40 space-y-6 bg-emerald-950/20">
                        <div class="flex gap-2">
                            <input type="text" id="test-url-bypass" placeholder="URL..." class="w-full bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-xs text-white font-mono">
                            <button onclick="testBypassApi()" class="px-5 py-3 bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 rounded-xl text-xs font-bold">Bypass</button>
                        </div>
                        <div id="test-result-box-bypass" class="hidden p-3 bg-emerald-950/80 rounded-xl font-mono text-xs text-emerald-300"><pre id="test-result-json-bypass"></pre></div>
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs text-emerald-400"><span>cURL Example</span><button onclick="copyCode('code-bypass-curl', this)" class="px-2 py-1 bg-emerald-900 text-white rounded text-[10px]">Copy</button></div>
                            <div class="p-3 bg-emerald-950 rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto"><pre id="code-bypass-curl">curl "https://apikeyzenuth.vercel.app/api/bypass?apikey=YOUR_KEY&url=https://sfl.gl/xxx"</pre></div>
                        </div>
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs text-emerald-400"><span>JavaScript Example</span><button onclick="copyCode('code-bypass-js', this)" class="px-2 py-1 bg-emerald-900 text-white rounded text-[10px]">Copy</button></div>
                            <div class="p-3 bg-emerald-950 rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto"><pre id="code-bypass-js">const res = await fetch('https://apikeyzenuth.vercel.app/api/bypass?apikey=YOUR_KEY&url=https://sfl.gl/xxx');
const data = await res.json();
console.log(data.result);</pre></div>
                        </div>
                    </div>
                </div>

                <!-- CALC -->
                <div class="rounded-2xl bg-emerald-950/30 border border-emerald-900/50 overflow-hidden">
                    <button onclick="toggleAccordion('calc')" class="w-full p-4 sm:p-5 flex items-center justify-between hover:bg-emerald-900/20 transition text-left">
                        <div class="flex items-center gap-3 font-mono text-xs sm:text-sm">
                            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold">GET</span>
                            <span class="text-white font-bold">/api/calc</span>
                            <span class="text-emerald-400/60 text-xs hidden sm:inline">- Kalkulator Engine</span>
                        </div>
                        <i id="accordion-icon-calc" class="fa-solid fa-chevron-right text-emerald-400 text-sm transition-transform duration-300"></i>
                    </button>
                    <div id="accordion-content-calc" class="hidden p-5 border-t border-emerald-900/40 space-y-6 bg-emerald-950/20">
                        <div class="flex gap-2">
                            <input type="number" id="test-angka1" placeholder="A1" class="w-full bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-xs text-white font-mono">
                            <select id="test-op" class="bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-xs text-emerald-300 font-mono"><option value="+">+</option><option value="x">x</option></select>
                            <input type="number" id="test-angka2" placeholder="A2" class="w-full bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-xs text-white font-mono">
                            <button onclick="testCalcApi()" class="px-5 py-3 bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 rounded-xl text-xs font-bold">Hitung</button>
                        </div>
                        <div id="test-result-box-calc" class="hidden p-3 bg-emerald-950/80 rounded-xl font-mono text-xs text-emerald-300"><pre id="test-result-json-calc"></pre></div>
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs text-emerald-400"><span>cURL Example</span><button onclick="copyCode('code-calc-curl', this)" class="px-2 py-1 bg-emerald-900 text-white rounded text-[10px]">Copy</button></div>
                            <div class="p-3 bg-emerald-950 rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto"><pre id="code-calc-curl">curl "https://apikeyzenuth.vercel.app/api/calc?apikey=YOUR_KEY&angka1=10&op=x&angka2=5"</pre></div>
                        </div>
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs text-emerald-400"><span>JavaScript Example</span><button onclick="copyCode('code-calc-js', this)" class="px-2 py-1 bg-emerald-900 text-white rounded text-[10px]">Copy</button></div>
                            <div class="p-3 bg-emerald-950 rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto"><pre id="code-calc-js">const res = await fetch('https://apikeyzenuth.vercel.app/api/calc?apikey=YOUR_KEY&angka1=10&op=x&angka2=5');
const data = await res.json();
console.log(data.result);</pre></div>
                        </div>
                    </div>
                </div>

                <!-- PARAPHRASE -->
                <div class="rounded-2xl bg-emerald-950/30 border border-emerald-900/50 overflow-hidden">
                    <button onclick="toggleAccordion('paraphrase')" class="w-full p-4 sm:p-5 flex items-center justify-between hover:bg-emerald-900/20 transition text-left">
                        <div class="flex items-center gap-3 font-mono text-xs sm:text-sm">
                            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold">GET</span>
                            <span class="text-white font-bold">/api/paraphrase</span>
                            <span class="text-emerald-400/60 text-xs hidden sm:inline">- Groq Paraphrase</span>
                        </div>
                        <i id="accordion-icon-paraphrase" class="fa-solid fa-chevron-right text-emerald-400 text-sm transition-transform duration-300"></i>
                    </button>
                    <div id="accordion-content-paraphrase" class="hidden p-5 border-t border-emerald-900/40 space-y-6 bg-emerald-950/20">
                        <div class="flex gap-2">
                            <input type="text" id="test-text-para" placeholder="Teks..." class="w-full bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-xs text-white font-mono">
                            <button onclick="testParaApi()" class="px-5 py-3 bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 rounded-xl text-xs font-bold">Parafrase</button>
                        </div>
                        <div id="test-result-box-para" class="hidden p-3 bg-emerald-950/80 rounded-xl font-mono text-xs text-emerald-300"><pre id="test-result-json-para"></pre></div>
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs text-emerald-400"><span>cURL Example</span><button onclick="copyCode('code-para-curl', this)" class="px-2 py-1 bg-emerald-900 text-white rounded text-[10px]">Copy</button></div>
                            <div class="p-3 bg-emerald-950 rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto"><pre id="code-para-curl">curl "https://apikeyzenuth.vercel.app/api/paraphrase?apikey=YOUR_KEY&text=halo"</pre></div>
                        </div>
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs text-emerald-400"><span>JavaScript Example</span><button onclick="copyCode('code-para-js', this)" class="px-2 py-1 bg-emerald-900 text-white rounded text-[10px]">Copy</button></div>
                            <div class="p-3 bg-emerald-950 rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto"><pre id="code-para-js">const res = await fetch('https://apikeyzenuth.vercel.app/api/paraphrase?apikey=YOUR_KEY&text=halo');
const data = await res.json();
console.log(data.result);</pre></div>
                        </div>
                    </div>
                </div>

                <!-- STORY -->
                <div class="rounded-2xl bg-emerald-950/30 border border-emerald-900/50 overflow-hidden">
                    <button onclick="toggleAccordion('story')" class="w-full p-4 sm:p-5 flex items-center justify-between hover:bg-emerald-900/20 transition text-left">
                        <div class="flex items-center gap-3 font-mono text-xs sm:text-sm">
                            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold">GET</span>
                            <span class="text-white font-bold">/api/story</span>
                            <span class="text-emerald-400/60 text-xs hidden sm:inline">- Groq Story</span>
                        </div>
                        <i id="accordion-icon-story" class="fa-solid fa-chevron-right text-emerald-400 text-sm transition-transform duration-300"></i>
                    </button>
                    <div id="accordion-content-story" class="hidden p-5 border-t border-emerald-900/40 space-y-6 bg-emerald-950/20">
                        <div class="flex gap-2">
                            <input type="text" id="test-topic-story" placeholder="Tema..." class="w-full bg-emerald-950/60 border border-emerald-900/60 p-3 rounded-xl text-xs text-white font-mono">
                            <button onclick="testStoryApi()" class="px-5 py-3 bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 rounded-xl text-xs font-bold">Buat</button>
                        </div>
                        <div id="test-result-box-story" class="hidden p-3 bg-emerald-950/80 rounded-xl font-mono text-xs text-emerald-300"><pre id="test-result-json-story"></pre></div>
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs text-emerald-400"><span>cURL Example</span><button onclick="copyCode('code-story-curl', this)" class="px-2 py-1 bg-emerald-900 text-white rounded text-[10px]">Copy</button></div>
                            <div class="p-3 bg-emerald-950 rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto"><pre id="code-story-curl">curl "https://apikeyzenuth.vercel.app/api/story?apikey=YOUR_KEY&topic=petualangan"</pre></div>
                        </div>
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs text-emerald-400"><span>JavaScript Example</span><button onclick="copyCode('code-story-js', this)" class="px-2 py-1 bg-emerald-900 text-white rounded text-[10px]">Copy</button></div>
                            <div class="p-3 bg-emerald-950 rounded-xl font-mono text-xs text-emerald-300 overflow-x-auto"><pre id="code-story-js">const res = await fetch('https://apikeyzenuth.vercel.app/api/story?apikey=YOUR_KEY&topic=petualangan');
const data = await res.json();
console.log(data.result);</pre></div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- TAB 2: PENGATURAN -->
        <div id="tab-settings" class="hidden space-y-6">
            <div class="liquid-glass-glow p-6 sm:p-8 rounded-3xl space-y-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h2 class="text-xl font-bold text-white flex items-center gap-2"><i class="fa-solid fa-key text-emerald-400"></i> Pengaturan & Status API Key</h2>
                        <p class="text-emerald-300/70 text-xs sm:text-sm mt-1">Buat API Key baru atau pantau sisa limit harianmu.</p>
                    </div>
                    <button onclick="generateApiKey()" class="px-6 py-3 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 text-black font-extrabold rounded-2xl text-xs transition shadow-lg shadow-emerald-500/20"><i class="fa-solid fa-wand-magic-sparkles"></i> Generate API Key Baru</button>
                </div>

                <div class="p-6 rounded-2xl bg-emerald-950/60 border border-emerald-500/30 space-y-6">
                    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between border-b border-emerald-900/60 pb-4 gap-2">
                        <span class="text-xs font-mono text-emerald-400/80 uppercase tracking-wider">API Key Aktif:</span>
                        <div class="flex items-center gap-2 w-full sm:w-auto">
                            <span id="display-key" class="text-sm font-mono font-bold text-emerald-300 bg-emerald-950 px-3 py-1.5 rounded-xl border border-emerald-800/60 select-all">SAW-XXXXXX</span>
                            <button onclick="copyActiveKey()" class="px-3 py-1.5 bg-emerald-900/60 hover:bg-emerald-900 text-emerald-200 rounded-xl text-xs font-mono font-bold transition"><i class="fa-solid fa-copy"></i> Salin</button>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center font-mono">
                        <div class="p-4 bg-emerald-950/40 rounded-2xl border border-emerald-900/60 space-y-1">
                            <span class="text-emerald-400/70 text-[10px] uppercase tracking-wider block">Terpakai</span>
                            <span id="stat-used" class="text-2xl font-extrabold text-emerald-400">0</span>
                        </div>
                        <div class="p-4 bg-emerald-950/40 rounded-2xl border border-emerald-900/60 space-y-1">
                            <span class="text-emerald-400/70 text-[10px] uppercase tracking-wider block">Sisa Limit</span>
                            <span id="stat-remaining" class="text-2xl font-extrabold text-emerald-300">100</span>
                        </div>
                        <div class="p-4 bg-emerald-950/40 rounded-2xl border border-emerald-900/60 space-y-1">
                            <span class="text-emerald-400/70 text-[10px] uppercase tracking-wider block">Total Limit</span>
                            <span id="stat-limit" class="text-2xl font-extrabold text-white"><%= config.defaultLimit %></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 3: ERROR LOGS -->
        <div id="tab-logs" class="hidden space-y-6">
            <div class="liquid-glass p-6 sm:p-8 rounded-3xl space-y-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <h2 class="text-xl font-bold text-white flex items-center gap-2"><i class="fa-solid fa-bug text-rose-400"></i> Server Error Logs</h2>
                    <button onclick="fetchErrorLogs()" id="refresh-btn" class="px-5 py-2.5 bg-emerald-950/60 hover:bg-emerald-900/60 border border-emerald-900 text-emerald-300 rounded-xl text-xs font-bold transition flex items-center justify-center gap-2 shadow-md">
                        <i id="refresh-icon" class="fa-solid fa-rotate"></i> Refresh Logs
                    </button>
                </div>
                <div id="logs-container" class="space-y-3 max-h-[500px] overflow-y-auto pr-1">
                    <div class="text-center text-emerald-400/60 py-12 text-xs font-mono">Memuat log error...</div>
                </div>
            </div>
        </div>

    </div>

    <footer class="text-center text-emerald-500/60 text-xs mt-12 py-4"><%= config.siteName %> &bull; Neon Green Glass</footer>

    <script>
        let currentApiKey = localStorage.getItem('saw_api_key') || '';
        document.addEventListener('DOMContentLoaded', () => { if (currentApiKey) checkKeyStatus(currentApiKey); });

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('-translate-x-full');
            document.getElementById('sidebar-backdrop').classList.toggle('hidden');
        }

        function toggleAccordion(name) {
            document.getElementById(`accordion-content-${name}`).classList.toggle('hidden');
            document.getElementById(`accordion-icon-${name}`).classList.toggle('rotate-90');
        }

        function switchTab(tabName) {
            ['docs', 'settings', 'logs'].forEach(tab => {
                document.getElementById(`tab-${tab}`).classList.add('hidden');
                document.getElementById(`nav-${tab}`).className = "w-full text-left px-4 py-3 rounded-xl font-bold text-xs sm:text-sm flex items-center gap-3 text-emerald-400/70 hover:bg-emerald-950/40 hover:text-white";
            });
            document.getElementById(`tab-${tabName}`).classList.remove('hidden');
            document.getElementById(`nav-${tabName}`).className = "w-full text-left px-4 py-3 rounded-xl font-bold text-xs sm:text-sm flex items-center gap-3 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30";
            if (tabName === 'logs') fetchErrorLogs();
            toggleSidebar();
        }

        function copyCode(id, btn) {
            navigator.clipboard.writeText(document.getElementById(id).innerText).then(() => {
                let orig = btn.innerText;
                btn.innerText = 'Copied!';
                setTimeout(() => btn.innerText = orig, 2000);
            });
        }

        function copyActiveKey() {
            navigator.clipboard.writeText(document.getElementById('display-key').innerText).then(() => alert('✓ API Key disalin!'));
        }

        async function generateApiKey() {
            const res = await fetch('/api/generate-key', { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                currentApiKey = data.key;
                localStorage.setItem('saw_api_key', data.key);
                checkKeyStatus(data.key);
                alert('✓ API Key berhasil dibuat!');
            }
        }

        async function checkKeyStatus(key) {
            const res = await fetch(`/api/check-key?apikey=${key}`);
            const data = await res.json();
            if (data.success) {
                document.getElementById('display-key').innerText = data.key;
                document.getElementById('stat-used').innerText = data.used;
                document.getElementById('stat-remaining').innerText = data.remaining;
            }
        }

        async function testCsApi() {
            if (!currentApiKey) return alert('Buat API Key dulu di menu Pengaturan!');
            const nama = document.getElementById('cs-nama').value;
            const tanggalLahir = document.getElementById('cs-tgl').value;
            const asal = document.getElementById('cs-asal').value;
            const latarBelakang = document.getElementById('cs-latar').value;
            const vibe = document.getElementById('cs-vibe').value;
            const paragraf = document.getElementById('cs-paragraf').value;
            const catatan = document.getElementById('cs-catatan').value;

            if (!nama || !tanggalLahir || !asal) return alert('Nama, Tanggal Lahir, dan Asal wajib diisi!');

            const url = `/api/character-story?apikey=${currentApiKey}&nama=${encodeURIComponent(nama)}&tanggalLahir=${encodeURIComponent(tanggalLahir)}&asal=${encodeURIComponent(asal)}&latarBelakang=${encodeURIComponent(latarBelakang)}&vibe=${encodeURIComponent(vibe)}&paragraf=${encodeURIComponent(paragraf)}&catatan=${encodeURIComponent(catatan)}`;
            
            const res = await fetch(url);
            const data = await res.json();
            document.getElementById('test-result-box-cs').classList.remove('hidden');
            document.getElementById('test-result-json-cs').innerText = JSON.stringify(data, null, 2);
            checkKeyStatus(currentApiKey);
        }

        async function testAiApi() {
            if (!currentApiKey) return alert('Buat API Key dulu!');
            const prompt = document.getElementById('test-prompt-ai').value;
            const res = await fetch(`/api/ai?apikey=${currentApiKey}&prompt=${encodeURIComponent(prompt)}`);
            const data = await res.json();
            document.getElementById('test-result-box-ai').classList.remove('hidden');
            document.getElementById('test-result-json-ai').innerText = JSON.stringify(data, null, 2);
            checkKeyStatus(currentApiKey);
        }

        async function testTranslateApi() {
            if (!currentApiKey) return alert('Buat API Key dulu!');
            const text = document.getElementById('test-text-trans').value;
            const res = await fetch(`/api/translate?apikey=${currentApiKey}&text=${encodeURIComponent(text)}&to=en`);
            const data = await res.json();
            document.getElementById('test-result-box-trans').classList.remove('hidden');
            document.getElementById('test-result-json-trans').innerText = JSON.stringify(data, null, 2);
            checkKeyStatus(currentApiKey);
        }

        async function testBypassApi() {
            if (!currentApiKey) return alert('Buat API Key dulu!');
            const url = document.getElementById('test-url-bypass').value;
            const res = await fetch(`/api/bypass?apikey=${currentApiKey}&url=${encodeURIComponent(url)}`);
            const data = await res.json();
            document.getElementById('test-result-box-bypass').classList.remove('hidden');
            document.getElementById('test-result-json-bypass').innerText = JSON.stringify(data, null, 2);
            checkKeyStatus(currentApiKey);
        }

        async function testCalcApi() {
            if (!currentApiKey) return alert('Buat API Key dulu!');
            const a1 = document.getElementById('test-angka1').value;
            const op = document.getElementById('test-op').value;
            const a2 = document.getElementById('test-angka2').value;
            const res = await fetch(`/api/calc?apikey=${currentApiKey}&angka1=${a1}&op=${encodeURIComponent(op)}&angka2=${a2}`);
            const data = await res.json();
            document.getElementById('test-result-box-calc').classList.remove('hidden');
            document.getElementById('test-result-json-calc').innerText = JSON.stringify(data, null, 2);
            checkKeyStatus(currentApiKey);
        }

        async function testParaApi() {
            if (!currentApiKey) return alert('Buat API Key dulu!');
            const text = document.getElementById('test-text-para').value;
            const res = await fetch(`/api/paraphrase?apikey=${currentApiKey}&text=${encodeURIComponent(text)}`);
            const data = await res.json();
            document.getElementById('test-result-box-para').classList.remove('hidden');
            document.getElementById('test-result-json-para').innerText = JSON.stringify(data, null, 2);
            checkKeyStatus(currentApiKey);
        }

        async function testStoryApi() {
            if (!currentApiKey) return alert('Buat API Key dulu!');
            const topic = document.getElementById('test-topic-story').value;
            const res = await fetch(`/api/story?apikey=${currentApiKey}&topic=${encodeURIComponent(topic)}`);
            const data = await res.json();
            document.getElementById('test-result-box-story').classList.remove('hidden');
            document.getElementById('test-result-json-story').innerText = JSON.stringify(data, null, 2);
            checkKeyStatus(currentApiKey);
        }

        async function fetchErrorLogs() {
            const container = document.getElementById('logs-container');
            const icon = document.getElementById('refresh-icon');
            icon.classList.add('fa-spin');
            try {
                const res = await fetch('/api/logs');
                const data = await res.json();
                if (data.success && data.logs.length > 0) {
                    container.innerHTML = data.logs.map(l => `
                        <div class="p-4 rounded-2xl bg-emerald-950/60 border border-rose-500/30 space-y-1 font-mono text-xs">
                            <div class="flex items-center justify-between text-stone-400 text-[10px]">
                                <span class="text-rose-400 font-bold px-2 py-0.5 rounded-md bg-rose-950/60 border border-rose-900">[${l.statusCode}] ${l.endpoint}</span>
                                <span class="text-emerald-400/60">${l.timestamp}</span>
                            </div>
                            <p class="text-emerald-100 pt-1">${l.message}</p>
                        </div>
                    `).join('');
                } else {
                    container.innerHTML = `<div class="text-center text-emerald-400/60 py-12 text-xs font-mono bg-emerald-950/30 rounded-2xl border border-emerald-900/50">✓ Belum ada error tercatat. Server berjalan lancar!</div>`;
                }
            } catch (err) {
                container.innerHTML = `<div class="text-center text-rose-400 py-12 text-xs font-mono">Gagal memuat log.</div>`;
            } finally {
                setTimeout(() => icon.classList.remove('fa-spin'), 500);
            }
        }
    </script>
</body>
</html>
